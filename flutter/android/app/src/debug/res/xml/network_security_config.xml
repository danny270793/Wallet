<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: also trusts user-installed CAs (e.g. a corporate TLS-intercepting
     proxy's root cert) alongside the system trust store, so local dev works behind
     a MITM proxy like Zscaler. Only merged into debug builds - never release. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
