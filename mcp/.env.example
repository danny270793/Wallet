# Copy this file to `.env` and fill in your own values. `.env` is gitignored,
# so each user supplies their own credentials. The MCP signs in to Supabase
# at startup using SUPABASE_USER_EMAIL / SUPABASE_USER_PASSWORD so RLS scopes
# every query to your wallet rows.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_USER_EMAIL=you@example.com
SUPABASE_USER_PASSWORD=your-password
