            "state": "translated",
            "value": "You can explore Wallet without signing in. If you create an account, authentication is provided by Supabase. Your email and credentials are processed by Supabase; this app does not store your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes explorar Wallet sin iniciar sesión. Si creas una cuenta, la autenticación la proporciona Supabase. Tu correo y credenciales los procesa Supabase; esta app no guarda tu contraseña."
          }
        }
      }
    },
    "settingsPrivacyDataTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account (optional)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta (opcional)"
          }
        }
      }
    },
    "settingsPrivacyInfraBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you are signed in, the financial records you enter (accounts, cards, transactions, categories, tags, and transfers) are stored in Supabase and tied to your account. Guest use stays on this device. In the future we may also store other app-generated information in Supabase when you are signed in. Security and backups depend on that service. Use a strong password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando has iniciado sesión, los registros financieros que introduces (cuentas, tarjetas, movimientos, categorías, etiquetas y transferencias) se guardan en Supabase y quedan ligados a tu cuenta. El uso como invitado se queda en este dispositivo. En el futuro también podremos guardar otra información generada por la app en Supabase si has iniciado sesión. La seguridad y las copias de seguridad dependen de ese servicio. Usa una contraseña fuerte."
          }
        }
      }
    },
    "settingsPrivacyInfraTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What we store today — and later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué guardamos hoy — y más adelante"
          }
        }
      }
    },
    "settingsPrivacyNoticeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is a simple placeholder, not legal advice. Before production or an app store release, publish a privacy policy that matches your jurisdiction, your organization, and how you actually process data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto es un resumen orientativo, no asesoramiento legal. Antes de producción o de publicar en una tienda de apps, publica una política de privacidad acorde a tu jurisdicción, tu organización y cómo tratas los datos en la práctica."
          }
        }
      }
    },
    "settingsPrivacyNoticeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you ship"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de publicar"
          }
        }
      }
    },
    "settingsPrivacyPolicy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy policy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidad"
          }
        }
      }
    },
    "settingsPrivacySharingBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We do not sell your personal information or use your ledger to target ads. Apart from your chosen backend and sign-in service, this app is not designed to send your data to brokers or advertisers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No vendemos tu información personal ni usamos tu libro de cuentas para mostrarte anuncios segmentados. Salvo el backend y el servicio de autenticación que elijas, la app no está pensada para enviar tus datos a intermediarios ni anunciantes."
          }
        }
      }
    },
    "settingsPrivacySharingTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing and ads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir y publicidad"
          }
        }
      }
    },
    "settingsPrivacyTagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in uses Supabase and is optional until you want your data in the cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión usa Supabase y es opcional hasta que quieras tus datos en la nube."
          }
        }
      }
    },
